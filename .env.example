# Stripe payment link for the donate button. Leave empty to disable the button.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# Contact email shown in the UI. Leave empty to hide the email row.
NEXT_PUBLIC_CONTACT_EMAIL=

# Site name shown in the UI.
NEXT_PUBLIC_SITE_NAME=OrbitalWatch

# --- Optional server-only keys (not used yet; never prefix with NEXT_PUBLIC_) ---
# The environmental layers work without any key: ozone (NASA GIBS), air quality (Open-Meteo)
# and fires (NASA FIRMS public active-fire CSV files). See docs/layers/README.md.
# NASA FIRMS MAP_KEY for the area/CSV API (the current routes use the public active-fire files).
# FIRMS_MAP_KEY=
# OpenAQ v3 API key for station-level air quality (the current layer uses Open-Meteo CAMS model data).
# OPENAQ_API_KEY=
