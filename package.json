{
  "name": "orbitalwatch",
  "version": "0.6.1",
  "private": true,
  "description": "Real-time 3D satellite tracker: Earth, solar system and galaxy views with a HUD UI (Next.js + Three.js)",
  "author": "JCodesMore",
  "license": "MIT",
  "keywords": [
    "satellites",
    "three.js",
    "nextjs",
    "webgl",
    "space",
    "hud"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "satellite.js": "^7.1.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
